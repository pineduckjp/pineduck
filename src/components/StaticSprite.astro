---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";

import OptImg from "@/components/OptImg.astro";

import "@/styles/static-sprite.css";

interface Props {
  name: string; // 例: logo-icon-art
  width?: number;
  height?: number;
  alt?: string;
}

const { name, width, height, alt = "" } = Astro.props as Props;

const spriteEntries = await getCollection("spritesStatic");
if (spriteEntries.length === 0) {
  throw new Error("spritesStatic collection is empty");
}

const matches = spriteEntries.flatMap((entry: (typeof spriteEntries)[0]) =>
  Object.keys(entry.data.frames)
    .filter((frameName) => frameName === name)
    .map((frameName) => ({ entry, frameName })),
);

if (matches.length === 0) {
  throw new Error(`Unknown sprite name: ${name}`);
}

const [{ entry: spriteEntry, frameName: resolvedFrameName }] = matches;

const spriteData = spriteEntry.data;
const frame = spriteData.frames[resolvedFrameName];

const imageModules = import.meta.glob("/src/assets/sprites/static/*.webp", {
  eager: true,
  import: "default",
}) as Record<string, ImageMetadata>;

const imageKey = `/src/assets/sprites/static/${spriteData.meta.image}`;
const sheetImage = imageModules[imageKey];
if (!sheetImage) {
  throw new Error(`Sprite image not found: ${imageKey}`);
}

const originalW = frame.frame.w;
const originalH = frame.frame.h;

const hasWidth = typeof width === "number";
const hasHeight = typeof height === "number";

const finalW =
  hasWidth && hasHeight
    ? width
    : hasWidth
      ? width
      : hasHeight
        ? Math.round((height * originalW) / originalH)
        : originalW;
const finalH =
  hasWidth && hasHeight
    ? height
    : hasHeight
      ? height
      : hasWidth
        ? Math.round((width * originalH) / originalW)
        : originalH;

const wrapperStyle = {
  "--sprite-original-w": `${originalW}px`,
  "--sprite-original-h": `${originalH}px`,
  "--sprite-bg-x": `${-frame.frame.x}px`,
  "--sprite-bg-y": `${-frame.frame.y}px`,
  "--sprite-sheet-w": `${spriteData.meta.size.w}px`,
  "--sprite-sheet-h": `${spriteData.meta.size.h}px`,
  "--sprite-w-final": `${finalW}px`,
  "--sprite-h-final": `${finalH}px`,
};
---

<div class="static-sprite" style={wrapperStyle}>
  <OptImg
    class="static-sprite-sheet"
    src={sheetImage}
    alt={alt}
    width={spriteData.meta.size.w}
    height={spriteData.meta.size.h}
  />
</div>
