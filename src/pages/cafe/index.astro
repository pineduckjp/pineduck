---
import Layout from "@/layouts/SelectLayout.astro";

import SelectList from "@/components/SelectList.astro";

import { SITE_TITLE } from "@/consts.ts";

const siteTitle = "PineDuckカフェ | " + SITE_TITLE;
---

<Layout
  header={{
    name: "PineDuckカフェ",
    logoIcon: "logo-icon-cafe",
    url: "/cafe/",
  }}
  title={siteTitle}
  description="夜のカフェでおしゃべり。"
  canvas="canvas-cafe"
  index={true}
  breadcrumb={[
    { name: "PineDuck", symbol: "symbol-pineduck", url: "/" },
    { name: "PineDuckカフェ", symbol: "symbol-cafe" },
  ]}
  prevUrl="/"
>
  <p>
    PineDuckカフェは、夜に週2回程度オープンするオンラインカフェです。交流や相談が出来ます。
  </p>
  <p>開発開始時期は未定です。</p>

  <h2>ダウンロード</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-download",
        title: "Web版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "Android版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "iOS版(準備中)",
        openInNewTab: true,
      },
    ]}
  />

  <h2>アプリの情報</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-web",
        title: "販促ページ",
      },
      {
        symbol: "symbol-guide",
        title: "使い方ガイド",
      },
      {
        symbol: "symbol-terms",
        title: "利用規約",
      },
      {
        symbol: "symbol-privacy",
        title: "プライバシーポリシー",
      },
      {
        symbol: "symbol-commerce",
        title: "特定商取引法に基づく表記",
        url: "/commerce/?prev=%2Fcafe%2F",
      },
    ]}
  />

  <h2>お問い合わせ</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-email",
        title: "お問い合わせフォーム",
        url: "/contact/?prev=%2Fcafe%2F&app=pineduck-cafe",
      },
    ]}
  />
</Layout>
