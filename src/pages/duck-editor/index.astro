---
import Layout from "@/layouts/SelectLayout.astro";

import SelectList from "@/components/SelectList.astro";

import { SITE_TITLE } from "@/consts.ts";

const siteTitle = "アヒルのエディター | " + SITE_TITLE;
---

<Layout
  header={{
    name: "アヒルのエディター",
    logoIcon: "logo-icon-editor",
    url: "/duck-editor/",
  }}
  title={siteTitle}
  description="もっと開発を便利にするツール。"
  canvas="canvas-editor"
  index={true}
  breadcrumb={[
    { name: "PineDuck", symbol: "symbol-pineduck", url: "/" },
    { name: "アヒルのエディター", symbol: "symbol-editor" },
  ]}
  prevUrl="/"
>
  <p>アヒルのエディターは、開発を便利にするためのツールアプリです。</p>
  <p>開発開始時期は未定です。</p>

  <h2>ダウンロード</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-download",
        title: "Web版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "Android版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "iOS版(準備中)",
        openInNewTab: true,
      },
    ]}
  />

  <h2>アプリの情報</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-web",
        title: "販促ページ",
      },
      {
        symbol: "symbol-guide",
        title: "使い方ガイド",
      },
      {
        symbol: "symbol-terms",
        title: "利用規約",
      },
      {
        symbol: "symbol-privacy",
        title: "プライバシーポリシー",
      },
      {
        symbol: "symbol-commerce",
        title: "特定商取引法に基づく表記",
        url: "/commerce/?prev=%2Fduck-editor%2F",
      },
    ]}
  />

  <h2>お問い合わせ</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-email",
        title: "お問い合わせフォーム",
        url: "/contact-form/?prev=%2Fduck-editor%2F&app=pineduck-editor",
      },
    ]}
  />
</Layout>
