---
import Layout from "@/layouts/SelectLayout.astro";

import SelectList from "@/components/SelectList.astro";

import { SITE_TITLE } from "@/consts.ts";

const siteTitle = "アヒルのスターター | " + SITE_TITLE;
---

<Layout
  header={{
    name: "アヒルのスターター",
    logoIcon: "logo-icon-starter",
    url: "/duck-starter/",
  }}
  title={siteTitle}
  description="開発で面倒な手順をお任せ。"
  canvas="canvas-starter"
  index={true}
  breadcrumb={[
    { name: "PineDuck", symbol: "symbol-pineduck", url: "/" },
    { name: "アヒルのスターター", symbol: "symbol-starter" },
  ]}
  prevUrl="/"
>
  <p>
    アヒルのスターターは、Webサイトやアプリを簡単に作成できるようにするためのスターターキットです。
  </p>
  <p>開発開始時期は未定です。</p>

  <h2>ダウンロード</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-download",
        title: "Web版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "Android版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "iOS版(準備中)",
        openInNewTab: true,
      },
    ]}
  />

  <h2>アプリの情報</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-web",
        title: "販促ページ",
      },
      {
        symbol: "symbol-guide",
        title: "使い方ガイド",
      },
      {
        symbol: "symbol-terms",
        title: "利用規約",
      },
      {
        symbol: "symbol-privacy",
        title: "プライバシーポリシー",
      },
      {
        symbol: "symbol-commerce",
        title: "特定商取引法に基づく表記",
        url: "/commerce/?prev=%2Fduck-starter%2F",
      },
    ]}
  />

  <h2>お問い合わせ</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-email",
        title: "お問い合わせフォーム",
        url: "/contact-form/?prev=%2Fduck-starter%2F&app=pineduck-starter",
      },
    ]}
  />
</Layout>
