---
import Layout from "@/layouts/SelectLayout.astro";

import SelectList from "@/components/SelectList.astro";

import { SITE_TITLE } from "@/consts.ts";

const siteTitle = "PineDuckソーイング | " + SITE_TITLE;
---

<Layout
  header={{
    name: "PineDuckソーイング",
    logoIcon: "logo-icon-sewing",
    url: "/sewing/",
  }}
  title={siteTitle}
  description="裁縫をゲーム感覚で。"
  canvas="canvas-sewing"
  index={true}
  breadcrumb={[
    { name: "PineDuck", symbol: "symbol-pineduck", url: "/" },
    { name: "PineDuckソーイング", symbol: "symbol-sewing" },
  ]}
  prevUrl="/"
>
  <p>
    PineDuckソーイングは、裁縫の基本をゲーム感覚で楽しく気軽に学べるアプリです。
  </p>
  <p>開発開始時期は未定です。</p>

  <h2>ダウンロード</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-download",
        title: "Web版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "Android版(準備中)",
        openInNewTab: true,
      },
      {
        symbol: "symbol-download",
        title: "iOS版(準備中)",
        openInNewTab: true,
      },
    ]}
  />

  <h2>サイトの情報</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-web",
        title: "販促ページ",
      },
      {
        symbol: "symbol-guide",
        title: "使い方ガイド",
      },
      {
        symbol: "symbol-terms",
        title: "利用規約",
      },
      {
        symbol: "symbol-privacy",
        title: "プライバシーポリシー",
      },
      {
        symbol: "symbol-commerce",
        title: "特定商取引法に基づく表記",
        url: "/commerce/",
      },
    ]}
  />

  <h2>お問い合わせ</h2>
  <SelectList
    items={[
      {
        symbol: "symbol-email",
        title: "お問い合わせフォーム",
        url: "/contact-form/?prev=%2Fsewing%2F&app=pineduck-sewing",
      },
    ]}
  />
</Layout>
